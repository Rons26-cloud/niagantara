# Public frontend variables. Values prefixed with VITE_ are bundled for browsers.
VITE_APP_NAME=NIAGANTARA
VITE_API_URL=http://localhost:4000/api/v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/google-sheets/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
VITE_SUPABASE_URL=https://your-v2-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-v2-publishable-or-anon-key

# Required API server variables. Never expose these through a VITE_ prefix.
SUPABASE_URL=https://your-v2-project-ref.supabase.co
SUPABASE_ANON_KEY=your-v2-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-v2-server-only-key

# Optional API runtime variables.
HOST=0.0.0.0
PORT=4000

# Migration and RLS test tooling only. Not consumed by frontend applications.
DATABASE_URL=postgresql://postgres:replace-me@host:5432/postgres
SUPABASE_PROJECT_REF=your-v2-project-ref
SUPABASE_ACCESS_TOKEN=your-local-or-ci-access-token

# Supabase Auth Custom SMTP readiness metadata. Server/deployment tooling only.
# Enter the matching values in Supabase Dashboard > Authentication > SMTP Settings.
# Never prefix these variables with VITE_ or commit real credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@niagantara.com
SMTP_FROM_NAME=NIAGANTARA
SMTP_SECURE=

# Future integrations. Not required by the current Phase 1 runtime.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENT_SECRET_KEY=
