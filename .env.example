# Runtime identity (development | staging | production | test)
NODE_ENV=development
APP_ENV=development
APP_VERSION=0.1.0
BUILD_SHA=local
LOG_LEVEL=debug

# Public browser configuration. VITE_ values are bundled and must never be secrets.
VITE_APP_NAME=NIAGANTARA
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
VITE_BUILD_SHA=local
VITE_API_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public domain architecture
PUBLIC_APP_URL=https://niagantara.com
API_BASE_URL=https://api.niagantara.com/api/v1
DASHBOARD_URL=https://app.niagantara.com
MASTER_URL=https://master.niagantara.com
POS_URL=https://pos.niagantara.com

# API server-only Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_PROJECT_REF=your-project-ref

# API runtime hardening
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT=120

# Google OAuth and Sheets (server/worker only)
GOOGLE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/google-sheets/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
GOOGLE_API_TIMEOUT_MS=15000
SHEET_SYNC_INTERVAL_MS=5000
SHEET_REBUILD_PAGE_SIZE=500
WORKER_ID=niagantara-worker-local

# Supabase Auth custom SMTP operator checklist; not consumed by browsers.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@niagantara.com
SMTP_FROM_NAME=NIAGANTARA
SMTP_SECURE=false

# Local migration/audit tooling only. Never inject into application containers.
DATABASE_URL=postgresql://postgres:replace-with-password@replace-with-host:5432/postgres
SUPABASE_ACCESS_TOKEN=replace-with-local-cli-token
