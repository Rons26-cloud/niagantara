{
  "name": "niagantara-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "corepack pnpm -r --if-present run build",
    "lint": "eslint apps services packages --max-warnings 0",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smtp:check": "node scripts/check-smtp-config.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "dev:web": "corepack pnpm --filter @niagantara/web dev",
    "dev:dashboard": "corepack pnpm --filter @niagantara/dashboard dev",
    "dev:master": "corepack pnpm --filter @niagantara/master dev",
    "dev:pos": "corepack pnpm --filter @niagantara/pos dev",
    "dev:api": "corepack pnpm --filter @niagantara/api dev",
    "dev:worker": "corepack pnpm --filter @niagantara/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
